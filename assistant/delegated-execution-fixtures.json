      "cfg": {
        "runtime": {
          "delegation_enabled": true,
          "delegation_mode": "coordinator_v1",
          "delegation_dispatch_max_attempts": 2
        }
      },
      "input": {
        "plan_id": "fixture-exec-fail",
        "correlation_id": "fixture:exec:fail",
        "dispatch_failure_budget": {
          "fixture-exec-fail:task-1": 2
        },
        "user_request": "Run shell checks and perform critical cleanup.",
